FROM node:24-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS node-runtime

FROM rust:1.88-slim-bookworm@sha256:38bc5a86d998772d4aec2348656ed21438d20fcdce2795b56ca434cf21430d89

# Keep the build hermetic: the Node toolchain and official Tauri CLI are installed
# in this image, while the host only supplies the source tree through Docker.
COPY --from=node-runtime /usr/local /usr/local

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        file \
        libayatana-appindicator3-dev \
        libssl-dev \
        libwebkit2gtk-4.1-dev \
        libxdo-dev \
        librsvg2-dev \
        wget \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add rustfmt && corepack enable pnpm

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY config/patches ./config/patches
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY . .

RUN test -f src/renderer/web-index.html \
    && test -f src/renderer/src/web/main.tsx \
    && test -f resources/build/icon.png \
    && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check \
    && cargo metadata --manifest-path src-tauri/Cargo.toml --locked --no-deps --format-version 1 >/dev/null
