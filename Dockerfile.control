FROM node:24-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7

RUN apt-get update \
  && apt-get install -y --no-install-recommends git openssl procps python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY config/patches ./config/patches
RUN pnpm install --frozen-lockfile --ignore-scripts \
  && pnpm rebuild node-pty
COPY . .

CMD ["pnpm", "exec", "vitest", "run", "--config", "config/vitest.config.ts"]
