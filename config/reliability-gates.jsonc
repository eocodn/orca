      "id": "terminal-runtime.mobile-stream-budget",
      "title": "Runtime and mobile terminal streams keep snapshot and live-output bytes bounded",
      "maturity": "experimental",
      "protection": "partial",
      "owner": "terminal-runtime",
      "layer": "runtime-rpc-contract",
      "surfaces": [
