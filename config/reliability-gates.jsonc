      "id": "desktop-relay.assignment-backpressure",
      "title": "Desktop relay drain recovery cannot amplify a director outage",
      "maturity": "experimental",
      "protection": "partial",
      "owner": "desktop-runtime",
      "layer": "main-relay-state-machine",
      "surfaces": [
