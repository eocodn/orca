{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orca ADE",
  "version": "1.4.163-rc.1",
  "identifier": "ai.stably.orca.ade",
  "build": {
    "beforeDevCommand": "node config/scripts/prepare-agent-control-sidecar.mjs --profile debug && pnpm dev:web",
    "beforeBuildCommand": "node config/scripts/prepare-agent-control-sidecar.mjs --profile release && pnpm build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Orca ADE",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "externalBin": [
      "binaries/ade-worker",
      "binaries/ade-control"
    ],
    "icon": [
      "../resources/build/icon.png"
    ]
  }
}
