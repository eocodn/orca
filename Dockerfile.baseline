FROM node:24-bookworm-slim AS verifier

WORKDIR /workspace
COPY . .

CMD ["node", "--test", "config/scripts/verify-fork-baseline.node-test.mjs"]

FROM node:24-bookworm-slim AS project-checks

RUN apt-get update \
  && apt-get install -y --no-install-recommends git openssl procps python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM project-checks AS mobile-checks
WORKDIR /workspace/mobile
RUN pnpm install --frozen-lockfile
