FROM rust:1.85-slim-bookworm@sha256:9f841bbe9e7d8e37ceb96ed907265a3a0df7f44e3737d0b100e7907a679acb36

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git \
  && rm -rf /var/lib/apt/lists/*
RUN rustup component add rustfmt clippy

WORKDIR /workspace/rust
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/ade-host-core/Cargo.toml ade-host-core/Cargo.toml
COPY rust/ade-host-core/src ade-host-core/src
COPY rust/ade-host/Cargo.toml ade-host/Cargo.toml
COPY rust/ade-host/src ade-host/src
COPY rust/ade-worker/Cargo.toml ade-worker/Cargo.toml
COPY rust/ade-worker/src ade-worker/src
COPY rust/ade-worker/tests ade-worker/tests
COPY rust/ade-host-store/Cargo.toml ade-host-store/Cargo.toml
COPY rust/ade-host-store/src ade-host-store/src
COPY rust/ade-host-platform/Cargo.toml ade-host-platform/Cargo.toml
COPY rust/ade-host-platform/src ade-host-platform/src
COPY rust/ade-terminal/Cargo.toml ade-terminal/Cargo.toml
COPY rust/ade-terminal/src ade-terminal/src
COPY rust/ade-git/Cargo.toml ade-git/Cargo.toml
COPY rust/ade-git/src ade-git/src

COPY rust/ade-file/Cargo.toml ade-file/Cargo.toml
COPY rust/ade-file/src ade-file/src

RUN cargo test --workspace --locked

CMD ["sh", "-euc", "cargo fmt --all -- --check && cargo test --workspace --locked && cargo clippy --workspace --all-targets --locked -- -D warnings"]
